# Application runtime mode. Demo mode enables local/test fixtures and mock auth.
VITE_APP_MODE=demo

# Public browser configuration. Sentry stays disabled when the DSN is empty.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Values must be between 0 and 1. Invalid or omitted values safely become 0.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# Supply these only as protected CI environment variables for source-map uploads.
# Never rename SENTRY_AUTH_TOKEN with a VITE_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
