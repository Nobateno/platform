{
  "name": "@nobateno/provider-panel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "test:perf": "node scripts/check-bundle-size.mjs",
    "test:all": "pnpm test:run && pnpm test:e2e && pnpm test:a11y",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm test:perf && pnpm build-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^40.2.0",
    "@headlessui/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.69.0",
    "chart.js": "^4.4.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "i18next": "^26.3.6",
    "litepicker": "^2.0.12",
    "lodash": "^4.17.23",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "simplebar": "^6.2.5",
    "tailwind-merge": "^2.6.1",
    "tiny-slider": "^2.9.4",
    "tippy.js": "^6.3.7",
    "tom-select": "^2.3.1",
    "zoom-vanilla.js": "^2.0.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-transition-group": "^4.4.10",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.33",
    "postcss-advanced-variables": "^3.0.1",
    "postcss-import": "^16.0.0",
    "postcss-nesting": "^12.0.2",
    "storybook": "10.5.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
